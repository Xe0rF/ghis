# Maintainer: Xe0rF

pkgname=ghis
pkgver=0.1.0
pkgrel=1
pkgdesc='Per-repository GitHub Identity Switcher for git, gh, and zsh'
arch=('x86_64')
license=('AGPL-3.0-or-later')
options=('!debug')
depends=('gcc-libs' 'glibc' 'git' 'github-cli' 'zsh')
optdepends=(
  '1password: 1Password SSH Agent and SSH commit signing support'
  'openssh: SSH remotes and SSH commit signing diagnostics'
)
source=("file://${startdir}/../../dist/ghis-v${pkgver}-x86_64-unknown-linux-gnu.tar.gz")
sha256sums=('6d47960868951b34914b1e96f7f2b888d8c5f20c21b1cdafbc939af1244d8b0e')

package() {
  local release_dir="${srcdir}/ghis-v${pkgver}-x86_64-unknown-linux-gnu"

  install -Dm755 "${release_dir}/ghis" "${pkgdir}/usr/bin/ghis"
  install -Dm644 "${release_dir}/completions/_ghis" \
    "${pkgdir}/usr/share/zsh/site-functions/_ghis"
  install -Dm644 "${release_dir}/LICENSE" \
    "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "${release_dir}/README.md" \
    "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
